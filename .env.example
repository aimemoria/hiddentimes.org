# Copy this file to ".env" and fill in your own values. Never share or commit ".env".

# ---- Site ----
# The public address of your website (used in Google results, share previews and the sitemap).
SITE_URL=https://www.hiddentimes.org
ADMIN_PASSWORD=change-me-to-a-long-password
# Signs the admin sign-in cookie. Any long random text; set it on Vercel. (Falls back to ADMIN_PASSWORD.)
# SESSION_SECRET=
# PORT=3000

# ---- Database (PostgreSQL) ----
# Supabase: Connect → Connection string → "Transaction pooler" (port 6543), here and on Vercel.
# (The Session pooler, port 5432, allows only 15 connections in total and runs out.)
# Replace [YOUR-PASSWORD]. On Vercel, paste the certificate text into DATABASE_CA instead of DATABASE_CA_FILE.
# Neon:     Dashboard → Connection Details
DATABASE_URL=
# Encrypted connections are verified by default. If your provider uses its own certificate
# (Supabase does), download it and point to the file:
# DATABASE_CA_FILE=./certs/supabase-ca.crt
# DATABASE_SSL=auto

# ---- Image storage (any S3-compatible service) ----
# Supabase Storage: Project Settings → Storage → S3 Connection
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<your project region, e.g. eu-west-2>
#   S3_FORCE_PATH_STYLE=true
#   S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://images.hiddentimes.org   (your bucket's public or custom domain)
# AWS S3: leave S3_ENDPOINT empty, set S3_REGION (e.g. eu-west-2)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ---- Analytics ----
# Secret used to make the daily anonymous visitor codes. Any long random text; keep it private.
# ANALYTICS_SECRET=
