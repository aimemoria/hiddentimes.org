{
  "name": "hiddentimes-website",
  "version": "1.0.0",
  "private": true,
  "description": "HiddenTimes story publishing site with a private admin page.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "check:cloud": "node --env-file-if-exists=.env scripts/check-cloud.js",
    "migrate:cloud": "node --env-file-if-exists=.env scripts/migrate-to-cloud.js",
    "reset:password": "node --env-file-if-exists=.env scripts/reset-password.js",
    "test:db": "node scripts/test-db.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "dompurify": "^3.4.18",
    "express": "^4.21.2",
    "marked": "^15.0.12",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
